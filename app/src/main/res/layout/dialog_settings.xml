<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/url_label"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/url_hint"
            android:inputType="textUri"
            android:maxLines="3"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/pin_label"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pin_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pin_hint"
            android:inputType="number"
            android:maxLength="12"
            android:importantForAutofill="no" />

        <CheckBox
            android:id="@+id/keep_screen_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/keep_screen_on" />

        <CheckBox
            android:id="@+id/advanced_wakelock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_wakelock" />

        <CheckBox
            android:id="@+id/autostart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/autostart" />

        <CheckBox
            android:id="@+id/lock_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_task" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/orientation_label"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/orientation_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/orientation_entries" />

    </LinearLayout>
</ScrollView>
